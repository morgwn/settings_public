;; Keys: up/down in *:Buffers:* while staying in main window
;;   (my/ibuffer-keys-mode -1)  ;; turn off
;;   (my/ibuffer-keys-mode 1)   ;; turn back on
(defvar my/ibuffer-keys-mode-map
  (let ((map (make-sparse-keymap)))
    (define-key map (kbd "C-M-i") (lambda () (interactive) (my/ibuffer-cycle 'prev)))
    (define-key map (kbd "C-M-k") (lambda () (interactive) (my/ibuffer-cycle 'next)))
    map)
  "Keymap for `my/ibuffer-keys-mode'.")
(define-minor-mode my/ibuffer-keys-mode
  "Global minor mode for ibuffer cycling keys."
  :global t
  :init-value t
  :keymap my/ibuffer-keys-mode-map)

;; Make ibuffer default to alphabetic sort
(setq ibuffer-default-sorting-mode 'alphabetic)

;; Narrower
(setq ibuffer-sidebar-width 25) 

(defun my/ibuffer-cycle (direction)
  "From the current window, move one buffer up/down in *:Buffers:* and show it here.
DIRECTION is 'next or 'prev."
  (interactive)
  (ibuffer-sidebar-show-sidebar)
  (let* ((main-win (selected-window))
         (cur-buf  (window-buffer main-win))
         (cur-name (buffer-name cur-buf))
         (ibuf     (get-buffer "*:Buffers:*"))
         (ibuf-win (cl-loop for win in (window-list)
                            when (eq (window-buffer win) ibuf)
                            return win)))
    (unless ibuf
      (user-error "No buffer named *:Buffers:*"))
    (unless ibuf-win
      (user-error "*:Buffers:* is not currently displayed in any window"))
    (unless cur-name
      (user-error "Current buffer has no name"))
    (select-window ibuf-win)
    (ibuffer-update nil)                      ;; refresh ibuffer [web:405]
    (goto-char (point-min))
    (unless (ibuffer-jump-to-buffer cur-name) ;; jump by name [web:405]
      (user-error "Current buffer %s not present in *:Buffers:*" cur-name))
    ;; if we're on 4th line and going up, just bail (don't move)
    (when (and (eq direction 'prev)
               (= (line-number-at-pos) 4))
      (select-window main-win)
      (switch-to-buffer cur-buf)
      (cl-return-from my/ibuffer-cycle))
    ;; if we're on last line and going down, bail
    (when (and (eq direction 'next)
               (save-excursion
                 (forward-line 1)
                 (eobp)))
      (select-window main-win)
      (switch-to-buffer cur-buf)
      (cl-return-from my/ibuffer-cycle))
    ;; move exactly one line in the chosen direction
    (pcase direction
      ('next (ibuffer-forward-line 1))
      ('prev (ibuffer-backward-line 1)))
    ;; try to get the buffer at this line; if none, keep the original
    (let* ((candidate (ibuffer-current-buffer))       ;; nil on headers [web:405][web:520]
           (next-buf (if (and candidate (buffer-live-p candidate))
                         candidate
                       cur-buf)))
      (select-window main-win)
      (switch-to-buffer next-buf))))

