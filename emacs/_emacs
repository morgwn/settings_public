(defun my/ibuffer-sync-once ()
  "If *:Buffers:* exists, move point to the current buffer's line when needed."
  (let* ((cur-win  (selected-window))
         (cur-buf  (window-buffer cur-win)))
    (unless (or (minibufferp cur-buf)
                (window-minibuffer-p cur-win))
      (let* ((cur-name (buffer-name cur-buf))
             (ibuf     (get-buffer "*:Buffers:*"))
             (ibuf-win (and ibuf
                            (cl-loop for win in (window-list)
                                     when (eq (window-buffer win) ibuf)
                                     return win))))
        (when (and ibuf ibuf-win cur-name)
          (save-selected-window
            (select-window ibuf-win)
            ;; Are we already on this buffer's line? If so, do nothing.
            (let ((here-name (my/ibuffer-line-buffer-name)))
              (unless (and here-name (string= here-name cur-name))
                (goto-char (point-min))
                (ignore-errors
                  (ibuffer-jump-to-buffer cur-name)))))))))) ;; same call style you had [web:405]

(defun my/ibuffer-sync-start ()
  "Start a repeating timer to sync *:Buffers:* every 2 seconds."
  (interactive)
  (unless (timerp my/ibuffer-sync-timer)
    (setq my/ibuffer-sync-timer
          (run-with-timer 0 2 #'my/ibuffer-sync-once)))) [web:713][web:716]

(defun my/ibuffer-sync-stop ()
  "Stop the repeating *:Buffers:* sync timer."
  (interactive)
  (when (timerp my/ibuffer-sync-timer)
    (cancel-timer my/ibuffer-sync-timer)
    (setq my/ibuffer-sync-timer nil)))

(my/ibuffer-sync-start)

