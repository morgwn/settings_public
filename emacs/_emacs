;; --- Robust external file-change watcher ---
(defvar my-last-mtime-table (make-hash-table :test 'eq)
  "Tracks last seen modification time for each buffer.")

;; Update mtime whenever you save a buffer
(defun my-update-last-mtime-on-save ()
  "Record the last-seen mtime after saving."
  (when buffer-file-name
    (puthash (current-buffer)
             (nth 5 (file-attributes buffer-file-name))
             my-last-mtime-table)))

(add-hook 'after-save-hook #'my-update-last-mtime-on-save)

;; Timer function to check for external changes
(defun my-poll-buffers-for-changes ()
  "Prompt to revert buffers whose files changed externally."
  (dolist (buf (buffer-list))
    (with-current-buffer buf
      (when buffer-file-name
        (let ((last (gethash buf my-last-mtime-table))
              (current (nth 5 (file-attributes buffer-file-name))))
          (when (and last (not (equal current last)))
            ;; update last-seen mtime immediately
            (puthash buf current my-last-mtime-table)
            ;; only prompt if buffer has no unsaved changes
            (unless (buffer-modified-p)
              (when (y-or-n-p
                     (format "File %s changed on disk. Revert buffer? "
                             (file-name-nondirectory buffer-file-name)))
                (revert-buffer :ignore-auto :noconfirm))))
          ;; initialize last-seen mtime for new buffers
          (puthash buf current my-last-mtime-table))))))

